{
  "name": "queueless-backend",
  "version": "1.0.0",
  "description": "QueueLess Campus — Smart Canteen Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "university:create": "node dist/scripts/createUniversity.js",
    "super-admin:create": "node dist/scripts/createSuperAdmin.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "canteen",
    "queueless",
    "campus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.4",
    "nodemailer": "^10.1.7",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
