# ─────────────────────────────────────────
# QueueLess Campus — Backend Environment
# Copy this file to .env and fill in values
# NEVER commit the real .env file
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/queueless?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/queueless?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS — no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Email (Nodemailer — will be used in Phase 2)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="QueueLess Campus <no-reply@queuelesscampus.com>"

# Razorpay (will be used in Phase 6)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

