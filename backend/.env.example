# ─────────────────────────────────────────
# QueueLess Campus — Backend Environment
# Copy this file to .env and fill in values
# NEVER commit the real .env file
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
# Set to the exact trusted proxy hop count when deployed behind a proxy (e.g. 1 on Render)
TRUST_PROXY_HOPS=0

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/queueless?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/queueless?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_random_secret_of_64_characters_or_more_for_local_development
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS — no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Email (required for registration and verification)
# Set SMTP_HOST, SMTP_USER, and SMTP_PASS together. These are required for signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Razorpay (optional; use test keys before accepting any real payments)
# Set both API values together; never expose the secret to the frontend.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=replace_with_test_key_secret
# Optional: webhook secret configured for /api/payments/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
