# ─────────────────────────────────────────────────────────
# QueueLess Campus — Frontend Environment
# Copy this file to .env.local and fill in values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NEVER put secrets here — everything is visible in the browser bundle.
# ─────────────────────────────────────────────────────────

# Backend API base URL
# In development the Vite proxy handles /api/* so you can leave this empty.
# Set this to your deployed backend URL for production builds.
VITE_API_URL=

